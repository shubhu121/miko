# Copy this file to `keystore.properties` (which is git-ignored) and fill in your values.
# Then release builds will be signed automatically.
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore miko-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias miko
#
# Get its SHA-1 (register this in the Firebase console for Google Sign-In):
#   keytool -list -v -keystore miko-release.jks -alias miko

storeFile=../miko-release.jks
storePassword=your_keystore_password
keyAlias=miko
keyPassword=your_key_password
